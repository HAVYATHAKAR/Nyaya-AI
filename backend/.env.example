# NyayaAI Backend Environment Config
# Copy to .env and fill in real values

# App
APP_NAME=NyayaAI
APP_ENV=development
APP_DEBUG=true
BACKEND_PORT=8000

# Database (use SQLite for dev, Postgres for prod)
DATABASE_URL=sqlite:///./data/db/nyayaai.db

# JWT
JWT_SECRET=dev-only-change-before-production-please-use-32-chars-min
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# CORS
CORS_ORIGINS=["http://localhost:3000"]

# OCR (PaddleOCR + pdf2image; PDF also requires Poppler system tools)
OCR_LANG=en  # PaddleOCR language: en, hi, ta, te, mr, bn, gu, pa, kn
OCR_USE_GPU=false

# HuggingFace Inference API
HF_TOKEN=
HF_MODEL=meta-llama/Meta-Llama-3-8B-Instruct
# Alternative free models: mistralai/Mistral-7B-Instruct-v0.3, HuggingFaceH4/zephyr-7b-beta

# Semantic retrieval is disabled until an authoritative, URL-cited corpus is configured.
# If enabled, install sentence-transformers and configure a reviewed corpus.
EMBEDDING_ENABLED=false
EMBED_MODEL=BAAI/bge-small-en-v1.5

# Qdrant Cloud (free tier)
QDRANT_URL=https://your-cluster-url.qdrant.tech
QDRANT_API_KEY=your_qdrant_api_key_here
QDRANT_COLLECTION=nyayaai_legal_kb

# Document storage
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=20
